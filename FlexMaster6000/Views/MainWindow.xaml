<Window x:Class="FlexMaster6000.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="FlexMaster 6000 - SmartSDR 4.0 Compatible"
        Height="700" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Window.Resources>
        <!-- Custom Styles -->
        <Style x:Key="HeaderText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Margin" Value="10,10,10,5"/>
        </Style>

        <Style x:Key="StatusText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <Style x:Key="SlicePanel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Menu Bar -->
            <RowDefinition Height="Auto"/> <!-- Status Bar -->
            <RowDefinition Height="*"/>    <!-- Main Content -->
            <RowDefinition Height="Auto"/> <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- Menu Bar -->
        <Menu Grid.Row="0" Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}">
            <MenuItem Header="Radio">
                <MenuItem Header="Connect" Click="MenuConnect_Click"/>
                <MenuItem Header="Disconnect" Click="MenuDisconnect_Click"/>
                <Separator/>
                <MenuItem Header="Exit" Click="MenuExit_Click"/>
            </MenuItem>
            <MenuItem Header="Slices">
                <MenuItem Header="Add Slice" Click="MenuAddSlice_Click"/>
                <MenuItem Header="Remove Selected" Click="MenuRemoveSlice_Click"/>
            </MenuItem>
            <MenuItem Header="Services">
                <MenuItem Header="Start HRD TCP Server" Click="MenuStartHrdTcp_Click"/>
                <MenuItem Header="Stop HRD TCP Server" Click="MenuStopHrdTcp_Click"/>
            </MenuItem>
            <MenuItem Header="Help">
                <MenuItem Header="About" Click="MenuAbout_Click"/>
                <MenuItem Header="Documentation" Click="MenuDocs_Click"/>
            </MenuItem>
        </Menu>

        <!-- Status Bar -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock x:Name="StatusRadio" Text="Radio: Not Connected" Style="{StaticResource StatusText}" FontWeight="Bold"/>
                    <TextBlock Text=" | " Foreground="Gray" Margin="5,0"/>
                    <TextBlock x:Name="StatusModel" Text="Model: N/A" Style="{StaticResource StatusText}"/>
                </StackPanel>

                <TextBlock x:Name="StatusMessage" Grid.Column="1" Text="Ready" Style="{StaticResource StatusText}" HorizontalAlignment="Center"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Ellipse x:Name="ConnectionIndicator" Width="12" Height="12" Fill="Red" Margin="5"/>
                    <TextBlock x:Name="ConnectionStatus" Text="Disconnected" Style="{StaticResource StatusText}" Margin="5,5,10,5"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Tabs -->
        <TabControl Grid.Row="2" Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource PrimaryBrush}">

            <!-- Overview Tab -->
            <TabItem Header="Overview">
                <ScrollViewer>
                    <StackPanel Margin="10">
                        <TextBlock Text="Radio Overview" Style="{StaticResource HeaderText}"/>

                        <Border Style="{StaticResource SlicePanel}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Radio Model:" FontWeight="Bold"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="OverviewModel" Text="Not Connected"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Serial Number:" FontWeight="Bold"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="OverviewSerial" Text="N/A"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Active Slices:" FontWeight="Bold"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="OverviewSliceCount" Text="0"/>
                            </Grid>
                        </Border>

                        <TextBlock Text="Quick Actions" Style="{StaticResource HeaderText}" Margin="10,20,10,5"/>

                        <StackPanel Orientation="Horizontal" Margin="10">
                            <Button Content="Connect to Radio" Click="MenuConnect_Click" Width="150" Margin="5"/>
                            <Button Content="Add Slice" Click="MenuAddSlice_Click" Width="150" Margin="5"/>
                            <Button Content="Start HRD Server" Click="MenuStartHrdTcp_Click" Width="150" Margin="5"/>
                        </StackPanel>

                        <TextBlock Text="About FlexMaster 6000" Style="{StaticResource HeaderText}" Margin="10,20,10,5"/>

                        <Border Style="{StaticResource SlicePanel}">
                            <TextBlock TextWrapping="Wrap">
                                <Run Text="FlexMaster 6000" FontWeight="Bold"/> is a modern, open-source application for enhanced control of Flex 6000 series radios.
                                <LineBreak/><LineBreak/>
                                <Run FontWeight="Bold">Features:</Run><LineBreak/>
                                • Full compatibility with SmartSDR 4.0<LineBreak/>
                                • Audio mixer with solo/mute controls<LineBreak/>
                                • HRD TCP listener for third-party integration<LineBreak/>
                                • CAT over TCP support<LineBreak/>
                                • Slice synchronization<LineBreak/>
                                • Modern WPF interface<LineBreak/>
                                <LineBreak/>
                                <Run FontWeight="Bold">Built with FlexLib API v3</Run>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Slices Tab -->
            <TabItem Header="Slices">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
                        <Button Content="Add Slice" Click="MenuAddSlice_Click" Width="100"/>
                        <Button Content="Remove" Click="MenuRemoveSlice_Click" Width="100"/>
                        <Button Content="Refresh" Click="RefreshSlices_Click" Width="100"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1" x:Name="SlicesDataGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              Background="{StaticResource SurfaceBrush}"
                              Foreground="{StaticResource TextBrush}"
                              Margin="10">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Slice" Binding="{Binding SliceLetter}" Width="50"/>
                            <DataGridTextColumn Header="Frequency" Binding="{Binding FrequencyMHz}" Width="120"/>
                            <DataGridTextColumn Header="Mode" Binding="{Binding Mode}" Width="80"/>
                            <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="60"/>
                            <DataGridCheckBoxColumn Header="TX" Binding="{Binding IsTxSlice}" Width="50"/>
                            <DataGridCheckBoxColumn Header="DAX" Binding="{Binding IsDaxEnabled}" Width="50"/>
                            <DataGridTextColumn Header="DAX Ch" Binding="{Binding DaxChannel}" Width="70"/>
                            <DataGridTextColumn Header="Gain" Binding="{Binding AudioGain}" Width="60"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Audio Mixer Tab -->
            <TabItem Header="Audio Mixer">
                <ScrollViewer>
                    <StackPanel Margin="10">
                        <TextBlock Text="Audio Mixer Controls" Style="{StaticResource HeaderText}"/>

                        <ItemsControl x:Name="MixerItemsControl" Margin="10">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource SlicePanel}" Width="150" Height="300">
                                        <StackPanel>
                                            <TextBlock Text="{Binding SliceLetter, StringFormat='Slice {0}'}"
                                                     FontWeight="Bold" FontSize="16" HorizontalAlignment="Center"/>

                                            <TextBlock Text="{Binding FrequencyMHz}"
                                                     HorizontalAlignment="Center" Margin="0,5"/>

                                            <Slider x:Name="GainSlider"
                                                  Orientation="Vertical"
                                                  Height="150"
                                                  Minimum="0" Maximum="100"
                                                  Value="{Binding AudioGain}"
                                                  TickFrequency="10"
                                                  HorizontalAlignment="Center"
                                                  Margin="0,10"/>

                                            <TextBlock Text="{Binding AudioGain, StringFormat='Gain: {0}'}"
                                                     HorizontalAlignment="Center"/>

                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10">
                                                <Button Content="M" Width="30" Height="30"
                                                      ToolTip="Mute" Margin="2"
                                                      FontWeight="{Binding IsMuted, Converter={StaticResource BoolToFontWeightConverter}}"/>
                                                <Button Content="S" Width="30" Height="30"
                                                      ToolTip="Solo" Margin="2"
                                                      FontWeight="{Binding IsSolo, Converter={StaticResource BoolToFontWeightConverter}}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Settings Tab -->
            <TabItem Header="Settings">
                <ScrollViewer>
                    <StackPanel Margin="10">
                        <TextBlock Text="HRD TCP Server Settings" Style="{StaticResource HeaderText}"/>

                        <Border Style="{StaticResource SlicePanel}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Port:" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="HrdPortTextBox" Text="7809" Width="100" HorizontalAlignment="Left"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Status:" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="HrdServerStatus" Text="Stopped" Foreground="Orange"/>

                                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="Start Server" Click="MenuStartHrdTcp_Click" Width="100" Margin="0,0,10,0"/>
                                    <Button Content="Stop Server" Click="MenuStopHrdTcp_Click" Width="100"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Text="Application Settings" Style="{StaticResource HeaderText}" Margin="10,20,10,5"/>

                        <Border Style="{StaticResource SlicePanel}">
                            <StackPanel>
                                <CheckBox Content="Auto-connect on startup" Margin="5"/>
                                <CheckBox Content="Minimize to system tray" Margin="5"/>
                                <CheckBox Content="Show inactive slices in mixer" Margin="5"/>
                                <CheckBox Content="Enable debug logging" Margin="5"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>

        <!-- Footer -->
        <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="0,1,0,0" Padding="10,5">
            <TextBlock>
                <Run Text="FlexMaster 6000 v1.0.0" FontWeight="Bold"/>
                <Run Text=" | "/>
                <Run Text="SmartSDR 4.0 Compatible"/>
                <Run Text=" | "/>
                <Run Text="Built with FlexLib API v3"/>
            </TextBlock>
        </Border>

    </Grid>
</Window>
