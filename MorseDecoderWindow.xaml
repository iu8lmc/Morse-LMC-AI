<Window x:Class="RadioLoggerApp.MorseDecoder.MorseDecoderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:oxy="http://oxyplot.org/wpf"
        mc:Ignorable="d"
        Title="Decodificatore Morse AI - RadioLogger Pro"
        Height="800" Width="1200"
        Background="#1E1E1E"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Stili moderni -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#005A9E"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#3E3E42"/>
                    <Setter Property="Foreground" Value="#A0A0A0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StopButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#D14C4C"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#B93030"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModernTextBlock" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="HeaderTextBlock" TargetType="TextBlock" BasedOn="{StaticResource ModernTextBlock}">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#252526" Padding="15" CornerRadius="4" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Decodificatore Morse con Intelligenza Artificiale"
                             Style="{StaticResource HeaderTextBlock}"/>
                    <TextBlock Text="Acquisizione audio in tempo reale e machine learning"
                             Style="{StaticResource ModernTextBlock}"
                             Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="txtStatus"
                             Text="Pronto"
                             Style="{StaticResource ModernTextBlock}"
                             VerticalAlignment="Center"
                             Margin="0,0,15,0"/>
                    <Ellipse x:Name="statusIndicator"
                           Width="12" Height="12"
                           Fill="#4EC9B0"
                           VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Controlli -->
        <Border Grid.Row="1" Background="#252526" Padding="15" CornerRadius="4" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="btnStart"
                          Content="Avvia Decodifica"
                          Style="{StaticResource ModernButton}"
                          Click="BtnStart_Click"
                          Width="150"/>
                    <Button x:Name="btnStop"
                          Content="Ferma"
                          Style="{StaticResource StopButton}"
                          Click="BtnStop_Click"
                          IsEnabled="False"
                          Width="100"
                          Margin="10,0,0,0"/>
                    <Button x:Name="btnClear"
                          Content="Pulisci"
                          Style="{StaticResource ModernButton}"
                          Click="BtnClear_Click"
                          Width="100"
                          Margin="10,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                    <TextBlock Text="Dispositivo Audio:"
                             Style="{StaticResource ModernTextBlock}"
                             VerticalAlignment="Center"
                             Margin="0,0,10,0"/>
                    <ComboBox x:Name="cmbAudioDevices"
                            Width="250"
                            Height="30"
                            Background="#3E3E42"
                            Foreground="White"
                            BorderBrush="#007ACC"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="btnExport"
                          Content="Esporta"
                          Style="{StaticResource ModernButton}"
                          Click="BtnExport_Click"
                          Width="100"/>
                    <Button x:Name="btnSettings"
                          Content="Impostazioni"
                          Style="{StaticResource ModernButton}"
                          Click="BtnSettings_Click"
                          Width="130"
                          Margin="10,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Contenuto principale -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Area testo decodificato -->
            <Border Grid.Column="0" Background="#252526" CornerRadius="4" Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Testo Decodificato"
                             Style="{StaticResource HeaderTextBlock}"
                             Margin="0,0,0,10"/>

                    <TextBox x:Name="txtDecoded"
                           Grid.Row="1"
                           Background="#1E1E1E"
                           Foreground="#4EC9B0"
                           FontFamily="Consolas"
                           FontSize="20"
                           FontWeight="Bold"
                           TextWrapping="Wrap"
                           IsReadOnly="True"
                           VerticalScrollBarVisibility="Auto"
                           BorderThickness="1"
                           BorderBrush="#3E3E42"
                           Padding="10"/>

                    <!-- Visualizzatore forma d'onda e spettro -->
                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="100"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="100"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#1E1E1E" CornerRadius="4" BorderThickness="1" BorderBrush="#3E3E42">
                            <oxy:PlotView x:Name="waveformPlot" Background="Transparent"/>
                        </Border>

                        <Border Grid.Row="2" Background="#1E1E1E" CornerRadius="4" BorderThickness="1" BorderBrush="#3E3E42">
                            <oxy:PlotView x:Name="spectrumPlot" Background="Transparent"/>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                        Width="10"
                        HorizontalAlignment="Stretch"
                        Background="Transparent"/>

            <!-- Pannello statistiche e controlli -->
            <Border Grid.Column="2" Background="#252526" CornerRadius="4" Padding="15">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Statistiche in tempo reale -->
                        <TextBlock Text="Statistiche"
                                 Style="{StaticResource HeaderTextBlock}"
                                 Margin="0,0,0,10"/>

                        <Border Background="#1E1E1E" Padding="10" CornerRadius="4" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Style="{StaticResource ModernTextBlock}">
                                    <Run Text="Frequenza: "/>
                                    <Run x:Name="txtFrequency" Text="0 Hz" FontWeight="Bold" Foreground="#4EC9B0"/>
                                </TextBlock>
                                <TextBlock Style="{StaticResource ModernTextBlock}" Margin="0,5,0,0">
                                    <Run Text="SNR: "/>
                                    <Run x:Name="txtSNR" Text="0 dB" FontWeight="Bold" Foreground="#4EC9B0"/>
                                </TextBlock>
                                <TextBlock Style="{StaticResource ModernTextBlock}" Margin="0,5,0,0">
                                    <Run Text="Velocità: "/>
                                    <Run x:Name="txtWPM" Text="0 WPM" FontWeight="Bold" Foreground="#4EC9B0"/>
                                </TextBlock>
                                <TextBlock Style="{StaticResource ModernTextBlock}" Margin="0,5,0,0">
                                    <Run Text="Confidenza: "/>
                                    <Run x:Name="txtConfidence" Text="0%" FontWeight="Bold" Foreground="#4EC9B0"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Livello audio -->
                        <TextBlock Text="Livello Audio"
                                 Style="{StaticResource HeaderTextBlock}"
                                 Margin="0,10,0,10"/>

                        <ProgressBar x:Name="audioLevelBar"
                                   Height="25"
                                   Background="#1E1E1E"
                                   Foreground="#4EC9B0"
                                   BorderBrush="#3E3E42"
                                   BorderThickness="1"
                                   Minimum="0"
                                   Maximum="100"
                                   Value="0"/>

                        <!-- Contatori -->
                        <TextBlock Text="Contatori"
                                 Style="{StaticResource HeaderTextBlock}"
                                 Margin="0,20,0,10"/>

                        <Border Background="#1E1E1E" Padding="10" CornerRadius="4" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Style="{StaticResource ModernTextBlock}">
                                    <Run Text="Caratteri: "/>
                                    <Run x:Name="txtCharCount" Text="0" FontWeight="Bold" Foreground="#4EC9B0"/>
                                </TextBlock>
                                <TextBlock Style="{StaticResource ModernTextBlock}" Margin="0,5,0,0">
                                    <Run Text="Errori: "/>
                                    <Run x:Name="txtErrorCount" Text="0" FontWeight="Bold" Foreground="#D14C4C"/>
                                </TextBlock>
                                <TextBlock Style="{StaticResource ModernTextBlock}" Margin="0,5,0,0">
                                    <Run Text="Accuratezza: "/>
                                    <Run x:Name="txtAccuracy" Text="100%" FontWeight="Bold" Foreground="#4EC9B0"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Stato AI -->
                        <TextBlock Text="Intelligenza Artificiale"
                                 Style="{StaticResource HeaderTextBlock}"
                                 Margin="0,20,0,10"/>

                        <Border Background="#1E1E1E" Padding="10" CornerRadius="4" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Style="{StaticResource ModernTextBlock}">
                                    <Run Text="Stato ML: "/>
                                    <Run x:Name="txtMLStatus" Text="Non addestrato" FontWeight="Bold"/>
                                </TextBlock>
                                <TextBlock Style="{StaticResource ModernTextBlock}" Margin="0,5,0,0">
                                    <Run Text="Accuratezza: "/>
                                    <Run x:Name="txtMLAccuracy" Text="0%" FontWeight="Bold"/>
                                </TextBlock>
                                <TextBlock Style="{StaticResource ModernTextBlock}" Margin="0,5,0,0">
                                    <Run Text="Dati training: "/>
                                    <Run x:Name="txtTrainingData" Text="0" FontWeight="Bold"/>
                                </TextBlock>
                                <Button x:Name="btnTrainAI"
                                      Content="Addestra AI"
                                      Style="{StaticResource ModernButton}"
                                      Click="BtnTrainAI_Click"
                                      Margin="0,10,0,0"
                                      HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </Border>

                        <!-- Log eventi -->
                        <TextBlock Text="Log Eventi"
                                 Style="{StaticResource HeaderTextBlock}"
                                 Margin="0,20,0,10"/>

                        <Border Background="#1E1E1E" CornerRadius="4" BorderThickness="1" BorderBrush="#3E3E42">
                            <TextBox x:Name="txtLog"
                                   Height="150"
                                   Background="Transparent"
                                   Foreground="#CCCCCC"
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   IsReadOnly="True"
                                   VerticalScrollBarVisibility="Auto"
                                   BorderThickness="0"
                                   Padding="5"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="3" Background="#252526" Padding="10" CornerRadius="4" Margin="0,10,0,0">
            <Grid>
                <TextBlock x:Name="txtStatusBar"
                         Text="Pronto per la decodifica Morse"
                         Style="{StaticResource ModernTextBlock}"
                         HorizontalAlignment="Left"/>
                <TextBlock x:Name="txtVersion"
                         Text="v1.0 - AI Enhanced"
                         Style="{StaticResource ModernTextBlock}"
                         HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</Window>
