<Window x:Class="RadioLoggerApp.MorseDecoder.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Impostazioni Avanzate - Morse Decoder AI"
        Height="650" Width="700"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- Stile per i GroupBox -->
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3E3E42"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10"/>
        </Style>

        <!-- Stile per i TextBlock -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#D4D4D4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,5"/>
        </Style>

        <!-- Stile per i Slider -->
        <Style TargetType="Slider">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Stile per i CheckBox -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#D4D4D4"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Stile per i Button -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#005A9E"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Stile per i TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3E3E42"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Height" Value="25"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ScrollViewer per le impostazioni -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Sezione Parametri Morse -->
                <GroupBox Header="Parametri Codice Morse">
                    <StackPanel>
                        <!-- Auto-calibrazione -->
                        <CheckBox x:Name="chkAutoCalibration" Content="Auto-calibrazione WPM (consigliato)" IsChecked="True"/>

                        <!-- WPM manuale -->
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="WPM (Words Per Minute):"/>
                            <Slider x:Name="sliderWPM" Grid.Column="1" Minimum="5" Maximum="60" Value="20"
                                    TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="SliderWPM_ValueChanged"/>
                            <TextBox x:Name="txtWPM" Grid.Column="2" Text="20" TextAlignment="Center" IsReadOnly="True"/>
                        </Grid>

                        <!-- Auto-frequenza -->
                        <CheckBox x:Name="chkAutoFrequency" Content="Rilevamento automatico frequenza" IsChecked="True" Margin="0,10,0,0"/>

                        <!-- Frequenza target -->
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Frequenza target (Hz):"/>
                            <Slider x:Name="sliderFrequency" Grid.Column="1" Minimum="200" Maximum="2000" Value="800"
                                    TickFrequency="100" IsSnapToTickEnabled="True" ValueChanged="SliderFrequency_ValueChanged"/>
                            <TextBox x:Name="txtFrequency" Grid.Column="2" Text="800" TextAlignment="Center" IsReadOnly="True"/>
                        </Grid>

                        <!-- Soglia rilevamento -->
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Soglia rilevamento:"/>
                            <Slider x:Name="sliderThreshold" Grid.Column="1" Minimum="0.1" Maximum="0.9" Value="0.3"
                                    TickFrequency="0.1" IsSnapToTickEnabled="False" ValueChanged="SliderThreshold_ValueChanged"/>
                            <TextBox x:Name="txtThreshold" Grid.Column="2" Text="0.30" TextAlignment="Center" IsReadOnly="True"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- Sezione DSP -->
                <GroupBox Header="Digital Signal Processing">
                    <StackPanel>
                        <!-- Bandwidth filtro -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Bandwidth filtro (Hz):"/>
                            <Slider x:Name="sliderBandwidth" Grid.Column="1" Minimum="50" Maximum="500" Value="100"
                                    TickFrequency="50" IsSnapToTickEnabled="True" ValueChanged="SliderBandwidth_ValueChanged"/>
                            <TextBox x:Name="txtBandwidth" Grid.Column="2" Text="100" TextAlignment="Center" IsReadOnly="True"/>
                        </Grid>

                        <!-- AGC -->
                        <CheckBox x:Name="chkAGC" Content="Abilita AGC (Automatic Gain Control)" IsChecked="True" Margin="0,10,0,0"/>

                        <!-- Noise Gate -->
                        <CheckBox x:Name="chkNoiseGate" Content="Abilita Noise Gate" IsChecked="True" Margin="0,10,0,0"/>

                        <!-- FFT Size -->
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="FFT Size (samples):"/>
                            <ComboBox x:Name="cmbFFTSize" Grid.Column="1" SelectedIndex="2" Background="#2D2D30"
                                      Foreground="White" BorderBrush="#3E3E42" Margin="5">
                                <ComboBoxItem Content="1024"/>
                                <ComboBoxItem Content="2048"/>
                                <ComboBoxItem Content="4096"/>
                                <ComboBoxItem Content="8192"/>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- Sezione AI/ML -->
                <GroupBox Header="Machine Learning">
                    <StackPanel>
                        <!-- Abilita AI -->
                        <CheckBox x:Name="chkEnableAI" Content="Abilita classificazione AI (Dit/Dah)" IsChecked="True"/>

                        <!-- Intervallo re-training -->
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Re-training ogni N campioni:"/>
                            <Slider x:Name="sliderRetraining" Grid.Column="1" Minimum="10" Maximum="200" Value="50"
                                    TickFrequency="10" IsSnapToTickEnabled="True" ValueChanged="SliderRetraining_ValueChanged"/>
                            <TextBox x:Name="txtRetraining" Grid.Column="2" Text="50" TextAlignment="Center" IsReadOnly="True"/>
                        </Grid>

                        <!-- Min dataset size -->
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Min dataset size:"/>
                            <Slider x:Name="sliderMinDataset" Grid.Column="1" Minimum="50" Maximum="500" Value="100"
                                    TickFrequency="50" IsSnapToTickEnabled="True" ValueChanged="SliderMinDataset_ValueChanged"/>
                            <TextBox x:Name="txtMinDataset" Grid.Column="2" Text="100" TextAlignment="Center" IsReadOnly="True"/>
                        </Grid>

                        <!-- Correzione errori -->
                        <CheckBox x:Name="chkErrorCorrection" Content="Abilita correzione errori AI" IsChecked="True" Margin="0,10,0,0"/>

                        <!-- Pulsanti gestione modello -->
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button x:Name="btnSaveModel" Content="Salva Modello" Width="150" Click="BtnSaveModel_Click"/>
                            <Button x:Name="btnLoadModel" Content="Carica Modello" Width="150" Click="BtnLoadModel_Click"/>
                            <Button x:Name="btnResetModel" Content="Reset Modello" Width="150" Background="#D14C4C" Click="BtnResetModel_Click"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- Sezione Audio -->
                <GroupBox Header="Configurazione Audio">
                    <StackPanel>
                        <!-- Buffer size -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Buffer size (ms):"/>
                            <Slider x:Name="sliderBufferSize" Grid.Column="1" Minimum="10" Maximum="200" Value="50"
                                    TickFrequency="10" IsSnapToTickEnabled="True" ValueChanged="SliderBufferSize_ValueChanged"/>
                            <TextBox x:Name="txtBufferSize" Grid.Column="2" Text="50" TextAlignment="Center" IsReadOnly="True"/>
                        </Grid>

                        <!-- Sample rate -->
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Sample Rate (Hz):"/>
                            <ComboBox x:Name="cmbSampleRate" Grid.Column="1" SelectedIndex="1" Background="#2D2D30"
                                      Foreground="White" BorderBrush="#3E3E42" Margin="5">
                                <ComboBoxItem Content="22050"/>
                                <ComboBoxItem Content="44100"/>
                                <ComboBoxItem Content="48000"/>
                            </ComboBox>
                        </Grid>

                        <!-- Latenza info -->
                        <TextBlock Margin="0,10,0,0" FontSize="11" Foreground="#888888">
                            Latenza stimata: ~70ms (buffer + processing + UI)
                        </TextBlock>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- Pulsanti di azione -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="btnResetDefaults" Content="Ripristina Default" Width="150"
                    Background="#505050" Click="BtnResetDefaults_Click"/>
            <Button x:Name="btnCancel" Content="Annulla" Width="100"
                    Background="#505050" Click="BtnCancel_Click"/>
            <Button x:Name="btnSave" Content="Salva" Width="100" Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>
